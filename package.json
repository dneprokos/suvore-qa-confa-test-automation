{
  "name": "suvore-qa-confa-test-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "lint:spec": "node scripts/spec-lint.mjs",
    "test:lint": "node --test \"scripts/__tests__/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
