
# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# playwright-cli exploration artifacts (snapshots, console logs)
/.playwright-cli/

# Credentials - Config reads these, they never belong in the repo
.env
.env.*
!.env.example

# QA workflow state and implementation reports
/.workflow/

# Generated architecture-review output (agentic-workflow-review skill's default --out)
/docs/review.md

# Claude Code local layer - machine-specific permissions and enabled MCP servers.
# .claude/agents/, .claude/skills/ and .mcp.json stay tracked.
.claude/settings.local.json

# Python bytecode from skill scripts
__pycache__/
*.pyc

# TypeScript
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Jira bug drafts (regenerated on every run)
/.jira-bug/

# Bug leakage export, metrics and dashboard (regenerated on every run)
/.bug-leakage/

# Slack triage per-run scratch (regenerated on every run).
# NOT .slack-triage/journal.jsonl — that ledger is tracked, because it is the only
# durable record that a Slack message already became a SCRUM ticket. Ignoring it
# means a second machine refiles every bug the first machine filed.
/.slack-triage/runs/
/.slack-triage/*.bak

# readme-polisher eval fixture: fake canary credentials, deliberately committed
!.claude/skills/readme-polisher/evals/files/node-service/.env
