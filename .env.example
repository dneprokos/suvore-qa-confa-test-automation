# Copy to .env and fill in. framework/configuration/config.ts validates this file
# with Joi at import time — a missing or malformed value throws before any test runs.

# Required
BASE_URL=http://localhost:9000
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional — defaults shown
HEADLESS_BROWSER=true
PORT=9000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Slack bug triage (/slack-bug-triage). Read by the Slack MCP server, NOT by
# framework/configuration/config.ts — `${VAR}` in .mcp.json expands from the
# process environment, so these must be real OS environment variables:
#   Windows:  setx SLACK_MCP_XOXB_TOKEN "xoxb-..."   (then restart the terminal)
#   POSIX:    export SLACK_MCP_XOXB_TOKEN=xoxb-...
# They are listed here so the required set is discoverable in one place.
# ---------------------------------------------------------------------------

# Slack bot OAuth token. Bot Token Scopes: channels:history, channels:read,
# groups:history, groups:read, reactions:read, reactions:write, chat:write, users:read.
# The bot must be invited to the triaged channel (/invite @<app-name>) or the first
# write fails not_in_channel, long after the reads succeeded.
SLACK_MCP_XOXB_TOKEN=

# The triaged channel, as an ID — a renamed channel keeps its ID, a renamed one loses its name.
SLACK_TRIAGE_CHANNEL_ID=C08ABCD1234

# The user id whose own messages the collector skips. Without it the workflow's own
# threaded replies read as new bug reports and it files tickets about itself.
SLACK_TRIAGE_SELF_USER_ID=U0BOT1234

# SLACK_MCP_ADD_MESSAGE_TOOL and SLACK_MCP_REACTION_TOOL gate posting and reactions;
# both are off unless set, and both accept a channel list. .mcp.json scopes them to
# SLACK_TRIAGE_CHANNEL_ID rather than `true`, so the token cannot post workspace-wide.
