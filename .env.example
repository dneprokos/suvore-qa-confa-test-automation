# Copy to .env and fill in. framework/configuration/config.ts validates this file
# with Joi at import time — a missing or malformed value throws before any test runs.

# Required
BASE_URL=http://localhost:9000
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional — defaults shown
HEADLESS_BROWSER=true
PORT=9000
NODE_ENV=development
